# Copie para `.env` (nunca commitado) e ajuste. Lido automaticamente pelo
# `barnes` e pelos testes; variáveis já definidas no terminal têm precedência.

# Banco de desenvolvimento (docker compose up -d → porta 5433).
# Contra o Postgres real do laboratório, troque só esta linha.
BARNES_DATABASE_URL=postgresql://barnes:barnes@localhost:5433/barnes

# Banco descartável da suíte de testes (tests/db/). Sem esta variável os
# testes de banco são pulados. NUNCA aponte para um banco com dados reais:
# os testes inserem e revertem linhas nele.
BARNES_TEST_DATABASE_URL=postgresql://barnes:barnes@localhost:5433/barnes_test
